# Server & API Configuration
VITE_SERVER_PORT=4000
VITE_API_URL=http://localhost:4000
NODE_ENV=development

# Frontend CORS Allowed Origins
LOCAL_IP_FRONTEND=http://localhost:5173
NETWORK_IP_FRONTEND=http://localhost:5173

# Database Configuration (Prisma)
DATABASE_URL="mysql://username:password@localhost:3306/chat_app"

# Optional Database Configuration (Fallback)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=chat_app

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30
